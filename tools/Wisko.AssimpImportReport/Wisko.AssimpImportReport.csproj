<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reports what an Assimp library makes of every model, to compare two builds of it (packaging/windows/NATIVE-LIBRARIES.md).
       A build tool: not part of the editor. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Wisko.AssimpImportReport</RootNamespace>
    <AssemblyName>Wisko.AssimpImportReport</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Assimp" Version="2.23.0" />
  </ItemGroup>

</Project>
