<Project Sdk="Microsoft.NET.Sdk">

  <!-- Makes Wisko's icon files from the logo artwork (see branding/README.md). A build tool: not part of the editor. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Wisko.BrandingAssets</RootNamespace>
    <AssemblyName>Wisko.BrandingAssets</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wisko.Tests" />
  </ItemGroup>

</Project>
